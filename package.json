{
  "name": "brodcasting-courseware",
  "private": true,
  "type": "module",
  "workspaces": [
    "labs/part-00",
    "labs/part-01",
    "labs/part-02/server",
    "labs/part-02/client",
    "labs/part-03/server",
    "labs/part-03/client",
    "labs/part-04/server"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "check:toolchain": "node --test checks/part-00/engines.test.mjs",
    "test": "node checks/part-00/run.mjs exercise unit",
    "check:exercise": "node checks/part-00/run.mjs exercise unit",
    "check:reference": "node checks/part-00/run.mjs reference unit",
    "test:e2e": "node checks/part-00/run.mjs exercise browser",
    "test:e2e:reference": "node checks/part-00/run.mjs reference browser",
    "dev": "npm run dev --workspace labs/part-00",
    "typecheck": "npm run typecheck --workspace labs/part-00",
    "build": "npm run build --workspace labs/part-00",
    "dev:part-01": "npm run dev --workspace labs/part-01",
    "typecheck:part-01": "npm run typecheck --workspace labs/part-01",
    "build:part-01": "npm run build --workspace labs/part-01",
    "check:part-01": "node checks/part-01/run.mjs exercise unit",
    "check:reference:part-01": "node checks/part-01/run.mjs reference unit",
    "dev:part-02:api": "npm run dev --workspace labs/part-02/server",
    "check:part-02:api": "node checks/part-02/run.mjs exercise server",
    "check:reference:part-02": "node checks/part-02/run.mjs reference all",
    "dev:part-02": "npm run dev --workspace labs/part-02/client",
    "typecheck:part-02": "npm run typecheck --workspace labs/part-02/server && npm run typecheck --workspace labs/part-02/client",
    "build:part-02": "npm run build --workspace labs/part-02/server && npm run build --workspace labs/part-02/client",
    "check:part-02": "node checks/part-02/run.mjs exercise all",
    "check:part-03:db": "node --env-file-if-exists=.env checks/part-03/run.mjs exercise db",
    "check:reference:part-03:db": "node --env-file-if-exists=.env checks/part-03/run.mjs reference db",
    "typecheck:part-03": "npm run typecheck --workspace labs/part-03/server && npm run typecheck --workspace labs/part-03/client",
    "build:part-03": "npm run build --workspace labs/part-03/server && npm run build --workspace labs/part-03/client",
    "db:part-03": "npm run build --workspace labs/part-03/server && node --env-file-if-exists=.env labs/part-03/server/dist/db-cli.js",
    "check:reference:part-03": "node --env-file-if-exists=.env checks/part-03/run.mjs reference all",
    "check:part-03": "node --env-file-if-exists=.env checks/part-03/run.mjs exercise all",
    "dev:part-03:api": "npm run build --workspace labs/part-03/server && node --env-file-if-exists=.env labs/part-03/server/dist/main.js",
    "dev:part-03": "npm run dev --workspace labs/part-03/client",
    "experiment:part-03": "npm run build --workspace labs/part-03/server && node --env-file-if-exists=.env labs/part-03/server/dist/experiment.js",
    "check:reference:part-04:db": "node --env-file-if-exists=.env checks/part-04/run.mjs reference db",
    "check:part-04:db": "node --env-file-if-exists=.env checks/part-04/run.mjs exercise db",
    "typecheck:part-04": "npm run typecheck --workspace labs/part-04/server",
    "build:part-04": "npm run build --workspace labs/part-04/server"
  },
  "devDependencies": {
    "semver": "7.8.5",
    "@playwright/test": "1.58.2",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "jsdom": "30.1.3",
    "@testing-library/react": "16.3.3"
  }
}
