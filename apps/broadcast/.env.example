# 별도의 로컬 실습 PostgreSQL만 사용합니다. 실제 비밀번호/secret은 이 예제에 넣지 않습니다.
PART06_ADMIN_URL=
PART06_DATABASE_URL=
PART06_APP_PASSWORD=
SESSION_SECRET=
PART06_BROWSER_ORIGIN=http://127.0.0.1:5190
PORT=3006

# 수동 구성 시 같은 전용 Redis와 course_r05_ 뒤 임의 8~32자리 16진수 prefix를 API/Worker에 설정합니다.
# 비워 두면 DB 접수만 저장되고 큐 투입은 false입니다. dev-lab은 자동 생성합니다.
BROADCAST_REDIS_URL=
BROADCAST_QUEUE_PREFIX=
